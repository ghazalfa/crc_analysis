// ---- crc-mutation-clusters : Nextflow configuration ----
manifest {
    name            = 'crc-mutation-clusters'
    description     = 'Driver-mutation clustering of TCGA COAD + READ, then expression and pathway analysis of the clusters'
    nextflowVersion = '>=24.04.0'
}

params {
    // inputs
    sources            = "${projectDir}/data/sources.csv"         // name,role,url,md5
    driver_genes       = "${projectDir}/data/crc_driver_genes.tsv"     // Nunes et al. 2024, Nature, doi:10.1038/s41586-024-07769-3
    report_template    = "${projectDir}/templates/report_template.md" // wording of the final report
    cache_dir          = "${projectDir}/data/raw"                 // downloaded files are kept here
    outdir             = "results"

    // mutation matrix
    min_freq           = 0.05     // keep panel genes mutated in >= 5% of tumours
    exome_mb           = 38       // exome size for TMB
    hypermut_tmb       = 10       // mut/Mb threshold for "hypermutated"
    exclude_hypermutated = false  // true = cluster only non-hypermutated tumours
    require_expression = true     // only tumours that also have RNA-seq

    // clustering
    linkage            = 'ward'   // ward | average | complete
    k_min              = 2
    k_max              = 8
    k                  = 2        // highest silhouette and both clusters stable; 0 = pick by silhouette
    min_cluster_size   = 20
    n_boot             = 200
    seed               = 501

    // differential expression (PyDESeq2)
    min_count          = 10       // keep genes with >= 10 reads in >= (smallest cluster) tumours
    min_site           = 10       // tissue source sites with fewer tumours are pooled as "other"
    de_covariates      = 'batch'  // comma-separated, or 'none'; design is ~ covariates + cluster
    de_alpha           = 0.05     // BH-adjusted p cutoff
    de_min_lfc         = 1        // |log2 fold change| cutoff
    max_cpus           = 6
}

// Every stage runs in one conda environment that Nextflow builds from envs/environment.yml.
conda {
    enabled       = true
    createTimeout = '1 h'
}

process {
    conda = "${projectDir}/envs/environment.yml"
    cpus  = 1
    withLabel: 'parallel' {
        cpus = { Math.min(params.max_cpus as int, Runtime.runtime.availableProcessors()) }
    }
    withName: 'FETCH' {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

env {
    OMP_NUM_THREADS = '1'
    MPLBACKEND      = 'Agg'
    PYTHONNOUSERSITE = '1'
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_report.html" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.mmd" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
